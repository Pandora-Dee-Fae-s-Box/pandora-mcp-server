#!/usr/bin/env bash
# Pre-commit hook for pandora-mcp-server
# Blocks commits that look like they contain local secrets or absolute paths.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

errors=0

# Patterns that should never leave the repo
forbidden_patterns=(
  # Absolute Windows paths that look like Mrrowr-murrr's local machine
  'F:\\\\PDA-SEASIDE'
  'F:/PDA-SEASIDE'
  'C:\\\\Users\\\\'
  'C:/Users/'
  # Generic private-key / API-key material
  'BEGIN RSA PRIVATE KEY'
  'BEGIN OPENSSH PRIVATE KEY'
  'BEGIN EC PRIVATE KEY'
  'BEGIN PRIVATE KEY'
  'sk-[a-zA-Z0-9]{20,}'   # OpenAI-style secret key
  'tavily[a-zA-Z0-9_-]{20,}' # Tavily key pattern
  'github[_-]?token[:=]\s*[a-zA-Z0-9_-]{20,}'
  'api[_-]?key[:=]\s*[a-zA-Z0-9_-]{20,}'
  'private[_-]?key[:=]\s*[a-zA-Z0-9_-]{20,}'
)

# Check staged files only
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [ -z "$staged" ]; then
  exit 0
fi

for file in $staged; do
  # Skip binary files and the hook itself
  case "$file" in
    .githooks/*) continue ;;
  esac

  for pattern in "${forbidden_patterns[@]}"; do
    if git diff --cached -- "$file" | grep -qEi "$pattern" 2>/dev/null; then
      echo -e "${RED}BLOCKED:${NC} $file matches forbidden pattern: ${YELLOW}$pattern${NC}"
      errors=$((errors + 1))
    fi
  done
done

if [ "$errors" -gt 0 ]; then
  echo -e "${RED}Commit blocked. Remove local secrets/absolute paths or use --no-verify with care.${NC}"
  exit 1
fi

exit 0
