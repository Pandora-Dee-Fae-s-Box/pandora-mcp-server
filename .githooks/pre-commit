#!/usr/bin/env bash
# Pre-commit hook for pandora-mcp-server
# Blocks commits whose added lines look like local secrets or absolute paths on this computer.
# (Install with ./setup-hooks.sh. Kept with LF line endings by .gitattributes: CRLF breaks bash.)

set -uo pipefail

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
NC=$'\033[0m'

# extended regexes, matched case-insensitively against the lines a commit adds
forbidden_patterns=(
  '[A-Z]:\\[^\\]'                       # a Windows path with backslashes, like C:\Users
  '[A-Z]:/[^/]'                         # the same with forward slashes, like C:/Users
  'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY'
  'sk-[a-zA-Z0-9]{20,}'                 # OpenAI-style secret key
  'tvly-[a-zA-Z0-9_-]{20,}'             # Tavily key
  'gh[pousr]_[A-Za-z0-9]{30,}'          # GitHub tokens
  'github[_-]?token[:=][[:space:]]*[a-zA-Z0-9_-]{20,}'
  'api[_-]?key[:=][[:space:]]*[a-zA-Z0-9_-]{20,}'
  'private[_-]?key[:=][[:space:]]*[a-zA-Z0-9_-]{20,}'
)

errors=0
staged=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)
[ -z "$staged" ] && exit 0

while IFS= read -r file; do
  case "$file" in
    .githooks/*) continue ;;   # this hook names the patterns themselves
  esac
  added=$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' || true)
  [ -z "$added" ] && continue
  for pattern in "${forbidden_patterns[@]}"; do
    if printf '%s\n' "$added" | grep -qEi -e "$pattern"; then
      printf '%sBLOCKED:%s %s matches %s%s%s\n' "$RED" "$NC" "$file" "$YELLOW" "$pattern" "$NC"
      errors=$((errors + 1))
    fi
  done
done <<< "$staged"

if [ "$errors" -gt 0 ]; then
  printf '%sCommit blocked.%s Remove the local secrets or absolute paths (or commit with --no-verify, with care).\n' "$RED" "$NC"
  exit 1
fi
exit 0
